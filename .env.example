# =============================================================================
# SmartSchedule Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values

# -----------------------------------------------------------------------------
# Supabase Configuration (Required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key (for server-side admin operations)
# WARNING: Never expose this key in client-side code!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# Session Management (Required for new auth flow)
# -----------------------------------------------------------------------------
# Generate a secret key for JWT session signing:
#   openssl rand -base64 32
SESSION_SECRET=your_32_character_secret_key

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable new authentication flow (JWT session cookies)
# Set to "true" to use the new auth pattern, "false" for legacy Supabase flow
USE_NEW_AUTH=false

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Base URL for the application (used for email links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
