# =============================================================================
# SmartSchedule Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values

# -----------------------------------------------------------------------------
# Demo Mode (Optional - for full working demo without backend)
# -----------------------------------------------------------------------------
# Set to "true" to enable demo mode with hardcoded data
# Perfect for showcasing the app without Supabase connection
# Demo includes: 5 user roles, 8 courses, 5 sections, 213 enrollments, 0 conflicts
NEXT_PUBLIC_DEMO_MODE=false

# Demo landing page: http://localhost:3000/demo
# Demo dashboards: http://localhost:3000/phase5

# When DEMO_MODE is enabled, all backend calls are bypassed and mock data is used
# Role switching allows testing all 5 user roles instantly

# Set to "true" and restart dev server to activate demo mode

# Before switching to false:
# 1. Make sure Supabase is configured (see below)
# 2. Verify SUPABASE_URL and SUPABASE_ANON_KEY are set
# 3. Run 'npm run db:start' if using local Supabase

# Use this in production: NEXT_PUBLIC_DEMO_MODE=false

# -----------------------------------------------------------------------------
# Supabase Configuration (Required if DEMO_MODE is false)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key (for server-side admin operations)
# WARNING: Never expose this key in client-side code!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# Session Management (Required for new auth flow)
# -----------------------------------------------------------------------------
# Generate a secret key for JWT session signing:
#   openssl rand -base64 32
SESSION_SECRET=your_32_character_secret_key

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable new authentication flow (JWT session cookies)
# Set to "true" to use the new auth pattern, "false" for legacy Supabase flow
USE_NEW_AUTH=false

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Base URL for the application (used for email links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
