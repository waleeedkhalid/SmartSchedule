### Key Tables (Timetabling System)

**User & Profile:**
- `users` - User accounts with roles (student, faculty, committee)
- `students` - Student profiles (level, status, current_term)
- `faculty` - Faculty profiles

**Pre-Semester (Input):**
- `elective_preferences` - Student course preferences (INPUT to scheduler)
- `faculty_availability` - Faculty availability windows
- `course` - Course catalog (REQUIRED + ELECTIVE)
- `section` - Course sections with assigned faculty/rooms
- `section_time` - Time slots for sections

**Generated (Output):**
- `schedules` - Generated student timetables (JSONB, OUTPUT from scheduler)

**Historical:**
- `enrollment` - Past course completions with grades (for transcripts)
- `academic_term` - Academic terms/semesters

**Supporting:**
- `elective_package` - Elective course groups
- `student_package_progress` - Package completion tracking
- `irregular_students` - Special cases tracking
- `feedback` - Student schedule feedback

## User Roles

1. **student** - Submit preferences, VIEW generated schedules (read-only)
2. **faculty** - Set availability, VIEW teaching schedules (read-only)
3. **scheduling_committee** - Run generator, publish schedules, manage conflicts
4. **teaching_load_committee** - Assign faculty to sections, manage workload
5. **registrar** - Manage terms, enter grades, handle special cases

## Data Fetching Quick Reference

### Server Components (Preferred)
```typescript
import { cache } from "react";
import { createServerClient } from "@/lib/supabase/server";

const getData = cache(async () => {
  const supabase = await createServerClient();
  const { data } = await supabase.from("table").select("*");
  return data;
});

export default async function Page() {
  const data = await getData();
  return <Component data={data} />;
}
```

### Client Components (When Needed)
```typescript
"use client";
import { useEffect, useState } from "react";
import { createBrowserClient } from "@/lib/supabase/client";

export function Component() {
  const [data, setData] = useState([]);
  const supabase = createBrowserClient();
  
  useEffect(() => {
    supabase.from("table").select("*").then(({ data }) => {
      setData(data);
    });
  }, []);
  
  return <div>{/* render */}</div>;
}
```

### Server Actions (Mutations)
```typescript
"use server";
import { revalidatePath } from "next/cache";
import { createServerClient } from "@/lib/supabase/server";

export async function createItem(formData: FormData) {
  const supabase = await createServerClient();
  const { error } = await supabase.from("table").insert({
    name: formData.get("name"),
  });
  
  if (error) throw error;
  revalidatePath("/path");
  return { success: true };
}
```

## Common Patterns

### ⚠️ Timetabling System Patterns (Avoid Common Mistakes)

```typescript
// ❌ WRONG: Building real-time enrollment
async function enrollStudent(studentId: string, courseCode: string) {
  // This is NOT an enrollment system!
  // Students don't enroll; scheduler assigns courses
}

// ✅ CORRECT: Collecting preferences
async function submitPreferences(studentId: string, preferences: Array<{course_code: string, order: number}>) {
  // Save to elective_preferences table
  // Will be used as INPUT to scheduler
  await supabase.from("elective_preferences").insert(preferences);
}

// ❌ WRONG: Letting student modify schedule
async function dropCourse(studentId: string, courseCode: string) {
  // Schedules are READ-ONLY during semester!
  // Only committee can modify
}

// ✅ CORRECT: Showing generated schedule
async function getStudentSchedule(studentId: string, termCode: string) {
  const { data } = await supabase
    .from("schedules")
    .select("*")
    .eq("student_id", studentId)
    .eq("term_code", termCode)
    .eq("is_published", true)
    .single();
  return data; // JSONB with sections, times, rooms
}

// ❌ WRONG: Using enrollment for current semester
async function getCurrentCourses(studentId: string) {
  // enrollment is HISTORICAL (past grades)
  return await supabase
    .from("enrollment")
    .select("*")
    .eq("student_id", studentId);
}

// ✅ CORRECT: Get current courses from generated schedule
async function getCurrentCourses(studentId: string, termCode: string) {
  const schedule = await supabase
    .from("schedules")
    .select("data")
    .eq("student_id", studentId)
    .eq("term_code", termCode)
    .eq("is_published", true)
    .single();
  return schedule?.data?.sections || []; // Parse JSONB
}
```

### Protected Page Pattern
```typescript
import { redirect } from "next/navigation";
import { getAuthenticatedUser, getUserProfile } from "@/lib/auth/cached-auth";

export default async function ProtectedPage() {
  const user = await getAuthenticatedUser();
  if (!user) redirect("/login");
  
  const profile = await getUserProfile();
  if (profile?.role !== "required_role") {
    redirect("/unauthorized");
  }
  
  return <PageContent />;
}
```

### Dashboard Pattern
```typescript
// Server Component - fetches data
export default async function DashboardPage() {
  const [stats, courses, students] = await Promise.all([
    getStats(),
    getCourses(),
    getStudents(),
  ]);
  
  return <DashboardClient stats={stats} courses={courses} students={students} />;
}

// Client Component - handles interactivity
"use client";
export function DashboardClient({ stats, courses, students }) {
  // Interactive UI here
}
```

