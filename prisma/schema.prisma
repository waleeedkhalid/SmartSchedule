generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UserRole {
  userId              String             @id @map("user_id") @db.Uuid
  role                UserRoleType
  name                String
  email               String
  onboardingCompleted Boolean            @default(false) @map("onboarding_completed")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdCourses      Course[]           @relation("CourseCreator")
  createdOfferings    CourseOffering[]   @relation("OfferingCreator")
  createdExams        Exam[]             @relation("ExamCreator")
  facultyProfile      FacultyProfile?
  createdIrregular    IrregularStudent[] @relation("IrregularCreator")
  irregularStudent    IrregularStudent?  @relation("IrregularStudent")
  notifications       Notification[]
  createdRooms        Room[]             @relation("RoomCreator")
  createdRules        Rule[]             @relation("RuleCreator")
  authoredComments    ScheduleComment[]  @relation("CommentAuthor")
  resolvedComments    ScheduleComment[]  @relation("CommentResolver")
  createdScheduleDocs ScheduleDoc[]      @relation("ScheduleDocCreator")
  createdSections     Section[]          @relation("SectionCreator")
  createdTimeline     SemesterTimeline[] @relation("TimelineCreator")
  studentProfile      StudentProfile?
  updatedTimeGrid     TimeGridConfig[]   @relation("TimeGridUpdater")

  @@index([role])
  @@map("user_roles")
}

model StudentProfile {
  userId         String              @id @map("user_id") @db.Uuid
  level          Int
  studentGroupId String?             @map("student_group_id") @db.Uuid
  department     String              @default("Software Engineering")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  enrollments    StudentEnrollment[]
  studentGroup   StudentGroup?       @relation(fields: [studentGroupId], references: [id])
  user           UserRole            @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([level])
  @@index([studentGroupId])
  @@index([level, studentGroupId])
  @@map("student_profile")
}

model FacultyProfile {
  userId           String    @id @map("user_id") @db.Uuid
  preferredTimes   Json      @default("[]") @map("preferred_times")
  unavailableTimes Json      @default("[]") @map("unavailable_times")
  maxLoadPerWeek   Int       @default(12) @map("max_load_per_week")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             UserRole  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  sections         Section[]

  @@map("faculty_profile")
}

model AcademicSemester {
  code                      String             @id
  name                      String
  type                      SemesterType
  startDate                 DateTime           @map("start_date") @db.Date
  endDate                   DateTime           @map("end_date") @db.Date
  isActive                  Boolean            @default(false) @map("is_active")
  electivesSurveyOpen       Boolean            @default(false) @map("electives_survey_open")
  registrationOpen          Boolean            @default(false) @map("registration_open")
  feedbackOpen              Boolean            @default(false) @map("feedback_open")
  schedulePublished         Boolean            @default(false) @map("schedule_published")
  isFacultyAvailabilityOpen Boolean            @default(false) @map("is_faculty_availability_open")
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  courseOfferings           CourseOffering[]
  timelineEvents            SemesterTimeline[]

  @@index([isActive])
  @@index([type])
  @@index([startDate, endDate])
  @@map("academic_semesters")
}

model SemesterTimeline {
  id          String           @id @default(uuid()) @db.Uuid
  termCode    String           @map("term_code")
  title       String
  description String?
  eventType   String           @map("event_type")
  category    String
  startDate   DateTime         @map("start_date") @db.Timestamptz(6)
  endDate     DateTime         @map("end_date") @db.Timestamptz(6)
  isRecurring Boolean          @default(false) @map("is_recurring")
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?          @map("created_by") @db.Uuid
  creator     UserRole?        @relation("TimelineCreator", fields: [createdBy], references: [userId])
  semester    AcademicSemester @relation(fields: [termCode], references: [code], onDelete: Cascade)

  @@index([termCode])
  @@index([startDate, endDate])
  @@index([eventType])
  @@index([category])
  @@map("semester_timeline")
}

model Course {
  code                String               @id
  title               String
  level               Int
  credits             Int
  weeklyHours         Int                  @map("weekly_hours")
  isElective          Boolean              @default(false) @map("is_elective")
  electiveGroupId     String?              @map("elective_group_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy           String?              @map("created_by") @db.Uuid
  creator             UserRole?            @relation("CourseCreator", fields: [createdBy], references: [userId])
  electiveGroup       ElectiveGroup?       @relation(fields: [electiveGroupId], references: [id])
  courseOfferings     CourseOffering[]
  prerequisites       CoursePrerequisite[] @relation("Course")
  requiredBy          CoursePrerequisite[] @relation("Prerequisite")
  electivePreferences ElectivePreference[]
  exams               Exam[]
  sections            Section[]

  @@index([level])
  @@index([isElective])
  @@index([electiveGroupId])
  @@map("course")
}

model ElectiveGroup {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String   @unique
  requiredCreditHours Int      @map("required_credit_hours")
  description         String?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  courses             Course[]

  @@index([name])
  @@map("elective_group")
}

model CoursePrerequisite {
  id               String   @id @default(uuid()) @db.Uuid
  courseCode       String   @map("course_code")
  prerequisiteCode String   @map("prerequisite_code")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  course           Course   @relation("Course", fields: [courseCode], references: [code], onDelete: Cascade)
  prerequisite     Course   @relation("Prerequisite", fields: [prerequisiteCode], references: [code], onDelete: Cascade)

  @@unique([courseCode, prerequisiteCode])
  @@index([courseCode])
  @@index([prerequisiteCode])
  @@map("course_prerequisite")
}

model CourseOffering {
  id           String           @id @default(uuid()) @db.Uuid
  courseCode   String           @map("course_code")
  semesterCode String           @map("semester_code")
  isActive     Boolean          @default(true) @map("is_active")
  maxSections  Int?             @map("max_sections")
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?          @map("created_by") @db.Uuid
  course       Course           @relation(fields: [courseCode], references: [code], onDelete: Cascade)
  creator      UserRole?        @relation("OfferingCreator", fields: [createdBy], references: [userId])
  semester     AcademicSemester @relation(fields: [semesterCode], references: [code], onDelete: Cascade)
  sections     Section[]

  @@unique([courseCode, semesterCode])
  @@index([semesterCode])
  @@index([isActive])
  @@index([courseCode])
  @@map("course_offering")
}

model Room {
  code      String    @id
  type      RoomType
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  creator   UserRole? @relation("RoomCreator", fields: [createdBy], references: [userId])
  sections  Section[]

  @@map("room")
}

model StudentGroup {
  id        String           @id @default(uuid()) @db.Uuid
  level     Int
  size      Int              @default(0)
  name      String
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?          @map("created_by") @db.Uuid
  exams     Exam[]
  students  StudentProfile[]

  @@index([level])
  @@map("student_group")
}

model Section {
  id                     String              @id @default(uuid()) @db.Uuid
  courseCode             String              @map("course_code")
  sectionNo              String              @map("section_no")
  instructorId           String?             @map("instructor_id") @db.Uuid
  roomCode               String?             @map("room_code")
  capacity               Int
  meetingPattern         Json                @map("meeting_pattern")
  groupLevel             Int                 @map("group_level")
  state                  SectionState        @default(draft)
  isScheduledByAlgorithm Boolean             @default(false) @map("is_scheduled_by_algorithm")
  courseOfferingId       String?             @map("course_offering_id") @db.Uuid
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy              String?             @map("created_by") @db.Uuid
  comments               ScheduleComment[]
  course                 Course              @relation(fields: [courseCode], references: [code], onDelete: Cascade)
  courseOffering         CourseOffering?     @relation(fields: [courseOfferingId], references: [id])
  creator                UserRole?           @relation("SectionCreator", fields: [createdBy], references: [userId])
  instructor             FacultyProfile?     @relation(fields: [instructorId], references: [userId])
  room                   Room?               @relation(fields: [roomCode], references: [code])
  enrollments            StudentEnrollment[]

  @@unique([courseCode, sectionNo])
  @@index([courseCode])
  @@index([instructorId])
  @@index([state])
  @@index([groupLevel])
  @@index([isScheduledByAlgorithm])
  @@index([courseOfferingId])
  @@map("section")
}

model Exam {
  id              String        @id @default(uuid()) @db.Uuid
  courseCode      String        @map("course_code")
  studentGroupId  String?       @map("student_group_id") @db.Uuid
  date            DateTime      @db.Date
  startTime       String        @map("start_time")
  durationMinutes Int           @map("duration_minutes")
  roomCodes       String[]      @map("room_codes")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?       @map("created_by") @db.Uuid
  course          Course        @relation(fields: [courseCode], references: [code], onDelete: Cascade)
  creator         UserRole?     @relation("ExamCreator", fields: [createdBy], references: [userId])
  studentGroup    StudentGroup? @relation(fields: [studentGroupId], references: [id])

  @@index([courseCode])
  @@index([date])
  @@index([studentGroupId])
  @@map("exam")
}

model Rule {
  id                         String    @id @default(uuid()) @db.Uuid
  timeBlocks                 Json      @map("time_blocks")
  forbiddenPairs             Json      @map("forbidden_pairs")
  examSpacingMins            Int       @default(120) @map("exam_spacing_mins")
  maxClassesPerInstructorDay Int       @default(4) @map("max_classes_per_instructor_day")
  maxClassesPerStudentDay    Int       @default(6) @map("max_classes_per_student_day")
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy                  String?   @map("created_by") @db.Uuid
  creator                    UserRole? @relation("RuleCreator", fields: [createdBy], references: [userId])

  @@map("rule")
}

model TimeGridConfig {
  id                        String    @id @default(uuid()) @db.Uuid
  teachingDays              String[]  @map("teaching_days")
  dailyStartTime            String    @default("08:00:00") @map("daily_start_time")
  dailyEndTime              String    @default("17:00:00") @map("daily_end_time")
  slotDurationMinutes       Int       @default(60) @map("slot_duration_minutes")
  breakStartTime            String    @default("12:00:00") @map("break_start_time")
  breakEndTime              String    @default("13:00:00") @map("break_end_time")
  examDays                  String[]  @map("exam_days")
  examStartTime             String    @default("09:00:00") @map("exam_start_time")
  examEndTime               String    @default("17:00:00") @map("exam_end_time")
  typicalLabDurationMinutes Int       @default(120) @map("typical_lab_duration_minutes")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy                 String?   @map("updated_by") @db.Uuid
  updater                   UserRole? @relation("TimeGridUpdater", fields: [updatedBy], references: [userId])

  @@map("time_grid_config")
}

model StudentEnrollment {
  id             String           @id @default(uuid()) @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  sectionId      String           @map("section_id") @db.Uuid
  status         EnrollmentStatus @default(registered)
  enrollmentType String           @default("elective") @map("enrollment_type")
  enrolledAt     DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  droppedAt      DateTime?        @map("dropped_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  section        Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student        StudentProfile   @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([studentId, sectionId])
  @@index([studentId])
  @@index([sectionId])
  @@index([status])
  @@index([enrollmentType])
  @@map("student_enrollment")
}

model IrregularStudent {
  id                  String    @id @default(uuid()) @db.Uuid
  studentId           String    @unique @map("student_id") @db.Uuid
  requiredCourseCodes String[]  @map("required_course_codes")
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy           String?   @map("created_by") @db.Uuid
  creator             UserRole? @relation("IrregularCreator", fields: [createdBy], references: [userId])
  student             UserRole  @relation("IrregularStudent", fields: [studentId], references: [userId], onDelete: Cascade)

  @@index([studentId])
  @@index([createdBy])
  @@map("irregular_student")
}

model ScheduleComment {
  id          String    @id @default(uuid()) @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  sectionId   String?   @map("section_id") @db.Uuid
  commentText String    @map("comment_text")
  isResolved  Boolean   @default(false) @map("is_resolved")
  resolvedBy  String?   @map("resolved_by") @db.Uuid
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  author      UserRole  @relation("CommentAuthor", fields: [authorId], references: [userId], onDelete: Cascade)
  resolver    UserRole? @relation("CommentResolver", fields: [resolvedBy], references: [userId])
  section     Section?  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([sectionId])
  @@index([isResolved])
  @@map("schedule_comment")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      UserRole  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@map("notification")
}

model ScheduleDoc {
  id               String    @id @default(uuid()) @db.Uuid
  content          Json      @default("{}")
  releaseTag       String?   @unique @map("release_tag")
  diffFromPrevious Json?     @map("diff_from_previous")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?   @map("created_by") @db.Uuid
  creator          UserRole? @relation("ScheduleDocCreator", fields: [createdBy], references: [userId])

  @@index([releaseTag])
  @@map("schedule_doc")
}

model ElectivePreference {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  courseCode String   @map("course_code")
  rank       Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  course     Course   @relation(fields: [courseCode], references: [code], onDelete: Cascade)

  @@unique([studentId, courseCode])
  @@index([studentId])
  @@map("elective_preference")
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  docId      String?  @map("doc_id") @db.Uuid
  targetRef  String   @map("target_ref")
  authorId   String   @map("author_id") @db.Uuid
  text       String
  isResolved Boolean  @default(false) @map("is_resolved")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([docId])
  @@index([authorId])
  @@map("comment")
}

enum UserRoleType {
  scheduling
  teaching_load
  faculty
  student
  registrar
}

enum RoomType {
  Lecture
  Lab
}

enum SectionState {
  draft
  released
}

enum EnrollmentStatus {
  registered
  dropped
}

enum SemesterType {
  FALL
  SPRING
  SUMMER
}
